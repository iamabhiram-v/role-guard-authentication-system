# Production environment template for the backend.
# Copy to `.env.production` on the deploy host (never commit the real file).
# env.ts loads `.env.${NODE_ENV}` first, so this is picked up automatically
# whenever NODE_ENV=production.
#
# validateEnv() (src/config/env.ts) will refuse to boot in production if
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET, JWT_REFRESH_SECRET,
# or REDIS_HOST are missing — fill all of those in before deploying.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# In docker-compose these are overridden to the service names (postgres/redis)
# automatically — only edit these if you're deploying outside compose
# (e.g. a managed Postgres/Redis host).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate long, random, unique secrets for production — never reuse the
# development values. e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Must be your real production frontend origin — the CORS allow-list in
# index.ts rejects anything not in this list (or localhost, for dev).
CORS_ORIGIN=https://your-domain.com
FRONTEND_URL=https://your-domain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/auth/oauth/google/callback

# Used by scripts/backup-db.sh
RETENTION_DAYS=14